rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
   match /feedback/{docId} {
          allow create: if request.auth != null;
          allow read: if request.auth != null &&
            (request.auth.uid == '1Mt7tpI4n2gCn71O6qE1EP2Fns03' ||
             resource.data.userId == request.auth.uid);
          allow update: if request.auth != null &&
            (request.auth.uid == '1Mt7tpI4n2gCn71O6qE1EP2Fns03' ||
             (resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyReadByUser'])));
          allow delete: if request.auth != null &&
            request.auth.uid == '1Mt7tpI4n2gCn71O6qE1EP2Fns03';
  }
    // ── 공유 문제집 (docs/shared-pool-design.md) ─────────────────────────
    // 관리자 판정은 위 feedback 규칙과 같은 uid 하드코딩을 따른다.
    // lib/admin.ts의 ADMIN_EMAIL은 화면 게이팅 전용이며 보안 판정에는 쓰지 않는다
    function isPoolOwner() {
      return request.auth != null
          && request.auth.uid == '1Mt7tpI4n2gCn71O6qE1EP2Fns03';
    }

    match /pools/{poolId} {
      // 발행된 문제집은 로그인한 사람이면 누구나 읽는다.
      // 예전에는 memberUids 명단에 든 사람만 읽을 수 있어, 관리자가 이메일로 한 명씩
      // 권한을 줘야 했다. 이제 발행 자체가 곧 공개다
      allow read: if request.auth != null;
      // 발행·발행취소·명단 수정은 소유자만
      allow write: if isPoolOwner();

      match /shards/{shardId} {
        // 루트와 같은 기준이다. 조각만 더 좁게 잠그면 목록은 보이는데 문항은 못 읽는다
        allow read: if request.auth != null;
        // 읽는 사람에게 쓰기를 주면 원본이 오염되고 받는 사람 전부에게 전파된다
        allow write: if isPoolOwner();
      }
    }

    // 이메일→uid 대응표. 관리자가 이메일로 권한을 줄 때 uid를 찾는 수단이다.
    // 필드를 셋으로 제한한다 — lib/firebaseServices/userDirectory.ts가 쓰는 것과 같아야 한다
    match /userDirectory/{uid} {
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['email', 'displayName', 'updatedAt']);
      // 이메일 수집을 막기 위해 조회는 관리자와 본인만
      allow read: if isPoolOwner() || (request.auth != null && request.auth.uid == uid);
      allow delete: if false;
    }
    
  }
}
